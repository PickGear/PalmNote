name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
  workflow_dispatch:

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  quality:
    name: Quality (lint, detekt, unit tests)
    runs-on: ubuntu-latest
    timeout-minutes: 45

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - uses: gradle/actions/setup-gradle@v4
        # 默认缓存 Gradle 依赖 + build cache + configuration cache（org.gradle.caching/configuration-cache 已在 gradle.properties 开启）。
        # fork 的 PR 只读不写缓存，避免缓存污染；主分支 push 正常读写。
        with:
          cache-read-only: ${{ github.event_name == 'pull_request' }}

      # 一次 Gradle 调用同时跑 lint + detekt + 单测（含 Robolectric 迁移测试）。
      # --continue 让某项失败时不中断其余任务，一次跑完所有结果。
      - name: Lint, detekt & unit tests
        run: ./gradlew lintDebug detekt testDebugUnitTest --continue

      # testDebugUnitTest 会触发 kspDebugKotlin（生成 app/schemas 与 core/schemas），
      # 这里直接校验导出的 Room schema 是否已提交，无需再跑一次 Gradle。
      - name: Verify Room schema is up to date
        run: |
          CHANGED=$(git status --porcelain app/schemas core/schemas)
          if [ -z "$CHANGED" ]; then
            echo "Room schemas are up to date."
          else
            echo "::error::Room schema JSON changed. Commit the updated schema."
            echo "$CHANGED"
            git diff app/schemas core/schemas
            exit 1
          fi

  build:
    name: Build (debug + release smoke)
    runs-on: ubuntu-latest
    timeout-minutes: 45

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - uses: gradle/actions/setup-gradle@v4
        # 默认缓存 Gradle 依赖 + build cache + configuration cache（org.gradle.caching/configuration-cache 已在 gradle.properties 开启）。
        # fork 的 PR 只读不写缓存，避免缓存污染；主分支 push 正常读写。
        with:
          cache-read-only: ${{ github.event_name == 'pull_request' }}

      - name: Build debug + release (unsigned smoke, no baseline profile)
        run: ./gradlew assembleDebug assembleRelease -x app:generateReleaseBaselineProfile -x app:generateBaselineProfile

      # 上传策略（公开仓库，控制 Actions 存储）：
      # - 日常 push 到 main 不上传：个人开发本地即可 assembleDebug，避免每次 push 积攒 82MB artifact。
      # - PR 上传且保留 1 天：让外部贡献者能取到产物真机验证；单个 PR 仅 ~82MB，可控。
      # - 手动触发 (workflow_dispatch) 上传且保留 3 天：需要留档时手动跑一次。
      - name: Upload APK
        if: github.event_name == 'pull_request' || github.event_name == 'workflow_dispatch'
        uses: actions/upload-artifact@v4
        with:
          name: PalmNote-debug
          path: app/build/outputs/apk/debug/*.apk
          retention-days: ${{ github.event_name == 'pull_request' && 1 || 3 }}
