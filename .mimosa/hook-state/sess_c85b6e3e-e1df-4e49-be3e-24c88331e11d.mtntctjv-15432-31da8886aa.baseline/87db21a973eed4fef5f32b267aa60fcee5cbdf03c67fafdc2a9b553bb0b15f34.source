name: Release

# 触发：推送语义化版本 tag（v1.2.3 / v1.2.3-rc.1 等），或手动运行。
# 流程：quality 检查 → assembleRelease（含 lintVital 门禁）→ 发布到 GitHub Release（APK + mapping.txt）。
# 参考 docs/release-checklist.md。

on:
  push:
    tags:
      - 'v*'
  workflow_dispatch:

concurrency:
  group: release-${{ github.ref }}
  cancel-in-progress: false

permissions:
  contents: write

jobs:
  quality:
    name: Quality (lint, detekt, unit tests)
    runs-on: ubuntu-latest
    timeout-minutes: 45
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - uses: gradle/actions/setup-gradle@v4
        with:
          cache-read-only: true

      - name: Lint, detekt & unit tests
        run: ./gradlew lintDebug detekt testDebugUnitTest --continue

  release:
    name: Build & publish release APK
    needs: quality
    runs-on: ubuntu-latest
    timeout-minutes: 60

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - uses: gradle/actions/setup-gradle@v4
        with:
          cache-read-only: true

      # 签名密钥注入：配置 RELEASE_JKS_BASE64（base64 编码的 release.jks）与
      # RELEASE_STORE_PASSWORD / RELEASE_KEY_ALIAS / RELEASE_KEY_PASSWORD secrets 后自动签名；
      # 未配置时退化为 unsigned 冒烟构建（可从仓库外手动补签）。
      - name: Inject release signing config
        shell: bash
        run: |
          if [ -n "${{ secrets.RELEASE_JKS_BASE64 }}" ]; then
            echo "${{ secrets.RELEASE_JKS_BASE64 }}" | base64 -d > release.jks
            cat >> local.properties <<EOF
            RELEASE_STORE_FILE=release.jks
            RELEASE_STORE_PASSWORD=${{ secrets.RELEASE_STORE_PASSWORD }}
            RELEASE_KEY_ALIAS=${{ secrets.RELEASE_KEY_ALIAS }}
            RELEASE_KEY_PASSWORD=${{ secrets.RELEASE_KEY_PASSWORD }}
            EOF
            echo "::notice::Release signing configured from secrets."
          else
            echo "::warning::No RELEASE_JKS_BASE64 secret; building unsigned APK."
          fi

      # assembleRelease 依赖 lintVitalRelease：致命 manifest/资源错误会在此失败（不过度跳过）。
      # -x app:generateReleaseBaselineProfile：baseline-prof.txt 已静态提交，无需模拟器生成。
      - name: Build release APK
        run: ./gradlew assembleRelease -x app:generateReleaseBaselineProfile -x app:generateBaselineProfile

      - name: Verify APK exists
        shell: bash
        run: |
          ls -la app/build/outputs/apk/release/*.apk

      # 发布到 GitHub Release：复用同名 tag 的既有 release（--clobber 覆盖同名 asset），
      # 无则创建。上传 APK + R8 mapping.txt（崩溃反解用）。
      - name: Publish to GitHub Release
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          TAG="${{ github.ref_name }}"
          APK=$(ls app/build/outputs/apk/release/*.apk | head -n1)
          MAPPING=app/build/outputs/mapping/release/mapping.txt
          ASSETS=("$APK")
          if [ -f "$MAPPING" ]; then ASSETS+=("$MAPPING"); fi

          if gh release view "$TAG" >/dev/null 2>&1; then
            echo "Release $TAG already exists; uploading assets."
            gh release upload "$TAG" "${ASSETS[@]}" --clobber
          else
            echo "Creating release $TAG."
            gh release create "$TAG" "${ASSETS[@]}" \
              --title "PalmNote $TAG" \
              --generate-notes
          fi

      # 留档：输出本次 release 的产物 hash，便于人工核对。
      - name: Output artifact digests
        shell: bash
        run: |
          sha256sum app/build/outputs/apk/release/*.apk
          sha256sum app/build/outputs/mapping/release/mapping.txt 2>/dev/null || true
