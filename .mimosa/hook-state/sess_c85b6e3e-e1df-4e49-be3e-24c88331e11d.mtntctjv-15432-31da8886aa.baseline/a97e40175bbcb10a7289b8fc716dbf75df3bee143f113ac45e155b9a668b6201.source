 * v6 → v7：删除 `bills` / `bills_recycle_bin` 表中从未被 UI 使用的 `timeOfDay` 死字段。
 *
 * 标准 Room 重建表模式：新建无该列的表 → 按列搬运数据 → 删旧表 → 重命名 → 重建索引与触发器。
 * 历史 SQL 数据迁移保持冻结，不做改写。
 */
val MIGRATION_6_7 = object : Migration(6, 7) {
    override fun migrate(db: SupportSQLiteDatabase) {
        rebuildBillsTable(db)
        rebuildBillsRecycleBinTable(db)
