    private fun createBillsIndices(db: SupportSQLiteDatabase) {
        val indices = listOf(
            "index_bills_yearMonth_type" to "(`yearMonth`, `type`)",
            "index_bills_accountBookId_yearMonth" to "(`accountBookId`, `yearMonth`)",
            "index_bills_type" to "(`type`)",
            "index_bills_date" to "(`date`)",
            "index_bills_isReimbursable_isReimbursed" to
                "(`isReimbursable`, `isReimbursed`)",
            "index_bills_recurringId" to "(`recurringId`)",
            "index_bills_category" to "(`category`)"
