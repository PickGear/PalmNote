            |`isReimbursed` INTEGER NOT NULL, `reimbursedDate` INTEGER,
            |`isTaxDeductible` INTEGER NOT NULL, `latitude` REAL,
            |`longitude` REAL, `isAutoGenerated` INTEGER NOT NULL,
            |`createdAt` INTEGER NOT NULL, `updatedAt` INTEGER NOT NULL)
            """.trimMargin()
        )
        db.execSQL(
            """
            |INSERT INTO new_bills
            |(`id`,`amount`,`type`,`category`,`subCategory`,`note`,
            |`date`,`yearMonth`,`accountBookId`,`walletId`,`toWalletId`,
            |`paymentMethod`,`merchant`,`transactionId`,`location`,
            |`tags`,`images`,`linkedAssetId`,`linkType`,`recurringId`,
            |`recurringFrequency`,`splitGroupId`,`isReimbursable`,
            |`isReimbursed`,`reimbursedDate`,`isTaxDeductible`,
            |`latitude`,`longitude`,`isAutoGenerated`,`createdAt`,
            |`updatedAt`)
            |SELECT
            |`id`,`amount`,`type`,`category`,`subCategory`,`note`,
            |`date`,`yearMonth`,`accountBookId`,`walletId`,`toWalletId`,
            |`paymentMethod`,`merchant`,`transactionId`,`location`,
            |`tags`,`images`,`linkedAssetId`,`linkType`,`recurringId`,
            |`recurringFrequency`,`splitGroupId`,`isReimbursable`,
            |`isReimbursed`,`reimbursedDate`,`isTaxDeductible`,
            |`latitude`,`longitude`,`isAutoGenerated`,`createdAt`,
            |`updatedAt` FROM bills
            """.trimMargin()
