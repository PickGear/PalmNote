        <group
            android:translateX="27"
            android:translateY="27">
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M12,8L40,8C42.2,8 44,9.8 44,12L44,40C44,42.2 42.2,44 40,44L12,44C9.8,44 8,42.2 8,40L8,12C8,9.8 9.8,8 12,8ZM12,12L8,12L8,40C8,40 8,40 8,40L40,40C40,40 44,40 44,40L44,12C44,12 44,12 44,12L12,12ZM14,16L38,16L38,20L14,20L14,16ZM14,24L30,24L30,28L14,28L14,24ZM14,32L26,32L26,36L14,36L14,32Z" />
        </group>
    </group>
</vector>
