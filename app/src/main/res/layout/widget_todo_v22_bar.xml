<?xml version="1.0" encoding="utf-8" ?>
<!--
  待办 4×1（v22 BAR）：徽章+待办 | 三列读数（今天 N 项 / 已完成 done/total / 下一件 时间）
  | 下方完成度条（条宽 = 已完成/总数）。
  第三列的标签是下一件事项的名字、值是它的时间；今天没有未完成事项时整列退「—」。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/widget_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingHorizontal="15dp"
        android:paddingVertical="9dp"
        android:background="@drawable/widget_card_round">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="@dimen/widget_v22_badge_sm"
                android:layout_height="@dimen/widget_v22_badge_sm">

                <ImageView
                    android:id="@+id/widget_todo_badge"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_shape_circle"
                    android:contentDescription="@null" />

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_gravity="center"
                    android:src="@drawable/widget_ic_check_white"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_todo_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="@string/widget_todo_title_short"
                android:textSize="@dimen/widget_v22_text_ttl"
                android:textStyle="bold"
                android:textColor="@color/widget_v22_text_1"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:layout_marginStart="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_todo_bar_today_lbl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_todos_label"
                        android:textSize="@dimen/widget_v22_text_micro"
                        android:textColor="@color/widget_v22_text_2"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/widget_todo_bar_today"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/widget_v22_text_val"
                        android:textStyle="bold"
                        android:textColor="@color/widget_v22_text_1"
                        android:maxLines="1"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:id="@+id/widget_todo_bar_done_lbl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_todo_label_done"
                        android:textSize="@dimen/widget_v22_text_micro"
                        android:textColor="@color/widget_v22_text_2"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/widget_todo_bar_done"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/widget_v22_text_val"
                        android:textStyle="bold"
                        android:textColor="@color/widget_v22_text_1"
                        android:maxLines="1"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:id="@+id/widget_todo_bar_next_lbl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/widget_v22_text_micro"
                        android:textColor="@color/widget_v22_text_2"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/widget_todo_bar_next"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/widget_v22_text_val"
                        android:textStyle="bold"
                        android:textColor="@color/widget_v22_text_1"
                        android:maxLines="1"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 完成度条：track 静态 line 轨 + fill clip（运行时上族色、level 定宽度） -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="9dp"
            android:layout_marginTop="5dp">

            <ImageView
                android:id="@+id/widget_todo_prog_track"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_v22_prog_track"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_todo_prog_fill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_bar_fill"
                android:contentDescription="@null" />
        </FrameLayout>

    </LinearLayout>

</FrameLayout>
