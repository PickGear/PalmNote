<?xml version="1.0" encoding="utf-8"?>
<!--
  v37 .kpis：KPI 横排（每块 = 淡底圆角块 + 标签/数值/副文），底与文字运行时按族上色。
  块根是 FrameLayout + 底图 ImageView（widget_v22_kpi_N_bg）—— setColorFilter 只能打在
  ImageView 上（LinearLayout 没有这个方法，RemoteViews 反射会抛 ActionException），
  与 widget_v22_chip 同一套路；文字 id 不变。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_v22_kpis_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/widget_v22_kpi_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/widget_v22_kpi_1_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_v22_round10"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="7dp">

            <TextView
                android:id="@+id/widget_v22_kpi_1_l"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_v22_kpi_1_v"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:fontFeatureSettings="tnum" />

            <TextView
                android:id="@+id/widget_v22_kpi_1_s"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/widget_v22_kpi_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="6dp">

        <ImageView
            android:id="@+id/widget_v22_kpi_2_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_v22_round10"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="7dp">

            <TextView
                android:id="@+id/widget_v22_kpi_2_l"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_v22_kpi_2_v"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:fontFeatureSettings="tnum" />

            <TextView
                android:id="@+id/widget_v22_kpi_2_s"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/widget_v22_kpi_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="6dp">

        <ImageView
            android:id="@+id/widget_v22_kpi_3_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_v22_round10"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="7dp">

            <TextView
                android:id="@+id/widget_v22_kpi_3_l"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_v22_kpi_3_v"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:fontFeatureSettings="tnum" />

            <TextView
                android:id="@+id/widget_v22_kpi_3_s"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/widget_v22_kpi_4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="6dp">

        <ImageView
            android:id="@+id/widget_v22_kpi_4_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_v22_round10"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="7dp">

            <TextView
                android:id="@+id/widget_v22_kpi_4_l"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_v22_kpi_4_v"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:fontFeatureSettings="tnum" />

            <TextView
                android:id="@+id/widget_v22_kpi_4_s"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
