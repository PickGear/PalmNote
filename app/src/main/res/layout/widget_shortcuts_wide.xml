<?xml version="1.0" encoding="utf-8"?>
<!--
  快捷入口 4×1 横条（v4）：2×2 的横向铺开 —— 四个入口一字排开（淡彩方块 + 名称）。
  与 2×2 复用同一套控件 id（widget_sc_*），Provider 的着色与点击绑定逻辑零分叉。
  拖到宽 ≥250dp 且高 <110dp 时由 Provider 切到此布局。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp"
    android:gravity="center_vertical"
    android:background="@drawable/widget_card_round">

    <LinearLayout
        android:id="@+id/widget_sc_add"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp">

            <ImageView
                android:id="@+id/widget_sc_add_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_sq_round"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_sc_add_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/widget_ic_plus_white"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_shortcut_add"
            android:textSize="@dimen/widget_text_micro"
            android:textColor="@color/widget_v2_text_secondary"
            android:layout_marginTop="3dp"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_sc_asset"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp">

            <ImageView
                android:id="@+id/widget_sc_asset_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_sq_round"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_sc_asset_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/widget_ic_box_white"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_shortcut_asset"
            android:textSize="@dimen/widget_text_micro"
            android:textColor="@color/widget_v2_text_secondary"
            android:layout_marginTop="3dp"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_sc_goal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp">

            <ImageView
                android:id="@+id/widget_sc_goal_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_sq_round"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_sc_goal_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/widget_ic_flag_white"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_shortcut_goal"
            android:textSize="@dimen/widget_text_micro"
            android:textColor="@color/widget_v2_text_secondary"
            android:layout_marginTop="3dp"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_sc_anniversary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp">

            <ImageView
                android:id="@+id/widget_sc_anniversary_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_sq_round"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_sc_anniversary_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/widget_ic_sparkle_white"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_shortcut_anniversary"
            android:textSize="@dimen/widget_text_micro"
            android:textColor="@color/widget_v2_text_secondary"
            android:layout_marginTop="3dp"
            android:maxLines="1" />
    </LinearLayout>

</LinearLayout>
