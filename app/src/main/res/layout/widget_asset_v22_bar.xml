<?xml version="1.0" encoding="utf-8"?>
<!--
  物品 4×1（v22 BAR）：徽章+物品 | 三列读数（在库 / 分类 / 最多）| 下方分段条。
  「最多」列的值为 色点+分类名+件数 一行；无分类时整列退「—」。
  分段条走 addView(widget_v22_seg)。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/widget_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingHorizontal="15dp"
        android:paddingVertical="9dp"
        android:background="@drawable/widget_card_round">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="@dimen/widget_v22_badge_sm"
                android:layout_height="@dimen/widget_v22_badge_sm">

                <ImageView
                    android:id="@+id/widget_asset_badge"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_shape_circle"
                    android:contentDescription="@null" />

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_gravity="center"
                    android:src="@drawable/widget_ic_box_white"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_asset_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="@string/widget_asset_title_short"
                android:textSize="@dimen/widget_v22_text_ttl"
                android:textStyle="bold"
                android:textColor="@color/widget_v22_text_1"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:layout_marginStart="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_asset_bar_total_lbl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_asset_label_total"
                        android:textSize="@dimen/widget_v22_text_micro"
                        android:textColor="@color/widget_v22_text_2"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/widget_asset_bar_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/widget_v22_text_val"
                        android:textStyle="bold"
                        android:textColor="@color/widget_v22_text_1"
                        android:maxLines="1"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:id="@+id/widget_asset_bar_cats_lbl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_asset_label_cats"
                        android:textSize="@dimen/widget_v22_text_micro"
                        android:textColor="@color/widget_v22_text_2"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/widget_asset_bar_cats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/widget_v22_text_val"
                        android:textStyle="bold"
                        android:textColor="@color/widget_v22_text_1"
                        android:maxLines="1"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:id="@+id/widget_asset_bar_most_lbl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_asset_label_most"
                        android:textSize="@dimen/widget_v22_text_micro"
                        android:textColor="@color/widget_v22_text_2"
                        android:maxLines="1" />

                    <LinearLayout
                        android:id="@+id/widget_asset_bar_most_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/widget_asset_bar_most_dot"
                            android:layout_width="@dimen/widget_v22_dot_xs"
                            android:layout_height="@dimen/widget_v22_dot_xs"
                            android:src="@drawable/widget_shape_circle"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/widget_asset_bar_most"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textSize="@dimen/widget_v22_text_val"
                            android:textStyle="bold"
                            android:textColor="@color/widget_v22_text_1"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 分段条宿主：addView(widget_v22_seg) -->
        <LinearLayout
            android:id="@+id/widget_asset_seg_host"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:orientation="horizontal"
            android:layout_marginTop="5dp" />

    </LinearLayout>

</FrameLayout>
