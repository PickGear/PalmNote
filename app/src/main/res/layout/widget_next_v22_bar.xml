<?xml version="1.0" encoding="utf-8"?>
<!--
  接下来 4×1（v22 BAR）：徽章+接下来 | 三列读数（还有 N 天 / 事件 / 日期）| 日历条。
  日历条一格 = 还剩一天（末格 = 事件日，族色底白字）：天数 ≤10 才画（格位就 10 个），
  超过就整条收起 —— 数字照样给，不把 30 天塞进 10 格。
  日历条走 addView(widget_v22_dstrip)。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/widget_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingHorizontal="15dp"
        android:paddingVertical="8dp"
        android:background="@drawable/widget_card_round">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="@dimen/widget_v22_badge_sm"
                android:layout_height="@dimen/widget_v22_badge_sm">

                <ImageView
                    android:id="@+id/widget_next_badge"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_shape_circle"
                    android:contentDescription="@null" />

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_gravity="center"
                    android:src="@drawable/widget_ic_clock_white"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_next_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="@string/widget_next_up_title"
                android:textSize="@dimen/widget_v22_text_ttl"
                android:textStyle="bold"
                android:textColor="@color/widget_v22_text_1"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:layout_marginStart="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_next_bar_left_lbl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_next_up_remaining"
                        android:textSize="@dimen/widget_v22_text_micro"
                        android:textColor="@color/widget_v22_text_2"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/widget_next_bar_left"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/widget_v22_text_val"
                        android:textStyle="bold"
                        android:textColor="@color/widget_v22_text_1"
                        android:maxLines="1"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:id="@+id/widget_next_bar_mid_lbl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_next_up_event"
                        android:textSize="@dimen/widget_v22_text_micro"
                        android:textColor="@color/widget_v22_text_2"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/widget_next_bar_mid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/widget_v22_text_val"
                        android:textStyle="bold"
                        android:textColor="@color/widget_v22_text_1"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:id="@+id/widget_next_bar_right_lbl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_next_up_date"
                        android:textSize="@dimen/widget_v22_text_micro"
                        android:textColor="@color/widget_v22_text_2"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/widget_next_bar_right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/widget_v22_text_val"
                        android:textStyle="bold"
                        android:textColor="@color/widget_v22_text_1"
                        android:maxLines="1"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 日历条宿主：addView(widget_v22_dstrip)，天数 >10 时 GONE -->
        <LinearLayout
            android:id="@+id/widget_next_strip_host"
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_v22_dcell"
            android:orientation="horizontal"
            android:layout_marginTop="5dp"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
