<?xml version="1.0" encoding="utf-8"?>
<!--
  待办组件的选择器/确认框静态预览（`previewLayout`，v4 设计稿 · 分段议程）：
  内容写死，结构与运行时 4×3 布局一致——左「今日完成 + 已完成明细」、
  右「今天/逾期/明天 分段议程 + 本周已完成」、头部「逾期 1」警示 pill。
  运行时行是桌面填充的，静态下直接把设计稿样例写死（数字与 design-v4.html 对齐）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/widget_pad"
    android:background="@drawable/widget_card_round">

    <!-- Header：色族徽章 + 标题 + 逾期警示 pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="@dimen/widget_icon_badge"
            android:layout_height="@dimen/widget_icon_badge">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/widget_shape_circle"
                android:backgroundTint="@color/widget_hue_3"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="&#10003;"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF"
                android:gravity="center" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_todo_title"
            android:textSize="@dimen/widget_text_title"
            android:textColor="@color/widget_v2_text_primary"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_overdue_1"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/widget_risk_red"
            android:background="@drawable/widget_pill_warn"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            tools:ignore="SmallSp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <!-- 左栏：今日完成 Hero + 进度条 + 已完成明细
             与运行时同口径改 1fr 等分双栏（稿 grid-template-columns:1fr 1fr；
             原 96dp 固定宽让分隔线比稿早到 60dp） -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_todo_done_label"
                android:textSize="@dimen/widget_text_micro"
                android:textColor="@color/widget_v2_text_tertiary" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2"
                    android:textSize="30sp"
                    android:textColor="@color/widget_v2_text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="/4"
                    android:textSize="13sp"
                    android:textColor="@color/widget_v2_text_tertiary"
                    android:textStyle="bold"
                    android:layout_marginStart="2dp" />
            </LinearLayout>

            <!--条高与稿同 10px、右缘离分隔线 10dp；样例 2/4 绿段 50% + 露灰 50%（原 seg_slot 满铺是满绿） -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="10dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/widget_bar_track"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <!-- RemoteViews 白名单没有裸 <View>，用 ImageView 当色段/占位 -->
                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/widget_seg_slot"
                        android:backgroundTint="@color/widget_hue_3"
                        android:contentDescription="@null" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:contentDescription="@null" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_done_cnt"
                android:textSize="10sp"
                android:textColor="@color/widget_v2_text_tertiary"
                android:layout_marginTop="10dp"
                tools:ignore="SmallSp" />

            <!-- 已完成明细 ×2：绿勾盒 + 三级色文字；删除线是运行时 paintFlags 加的，静态预览没有 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <FrameLayout
                    android:layout_width="13dp"
                    android:layout_height="13dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/widget_todo_check_done"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="&#10003;"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFFFF"
                        android:gravity="center"
                        tools:ignore="SmallSp" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widget_preview_todo_done_1"
                    android:textSize="10sp"
                    android:textColor="@color/widget_v2_text_tertiary"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:ignore="SmallSp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <FrameLayout
                    android:layout_width="13dp"
                    android:layout_height="13dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/widget_todo_check_done"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="&#10003;"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFFFF"
                        android:gravity="center"
                        tools:ignore="SmallSp" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widget_preview_todo_done_2"
                    android:textSize="10sp"
                    android:textColor="@color/widget_v2_text_tertiary"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:ignore="SmallSp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_todo_done_more"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/widget_hue_3"
                android:layout_marginTop="6dp"
                tools:ignore="SmallSp" />
        </LinearLayout>

        <ImageView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/widget_v2_ring"
            android:contentDescription="@null" />

        <!-- 右栏：分段议程（今天/逾期/明天）+ 本周已完成 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widget_today"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_hue_1"
                    tools:ignore="SmallSp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_preview_cnt_2"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_v2_text_secondary"
                    tools:ignore="SmallSp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="4dp">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/widget_todo_check_box"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widget_preview_todo_2"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_v2_text_primary"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="18:00"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_v2_text_secondary"
                    android:layout_marginStart="4dp"
                    tools:ignore="SmallSp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="4dp">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/widget_todo_check_box"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widget_preview_todo_3"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_v2_text_primary"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1/3"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_v2_text_secondary"
                    android:layout_marginStart="4dp"
                    tools:ignore="SmallSp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widget_overdue"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_risk_red"
                    tools:ignore="SmallSp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_preview_cnt_1"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_v2_text_secondary"
                    tools:ignore="SmallSp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="4dp">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/widget_todo_check_box"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widget_preview_todo_od"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_v2_text_primary"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_yesterday"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_risk_red"
                    android:layout_marginStart="4dp"
                    tools:ignore="SmallSp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widget_tomorrow"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_v2_text_tertiary"
                    tools:ignore="SmallSp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_preview_cnt_1"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_v2_text_secondary"
                    tools:ignore="SmallSp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="4dp">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/widget_todo_check_box"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/widget_preview_todo_tmr"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_v2_text_primary"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10/13"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_v2_text_secondary"
                    android:layout_marginStart="4dp"
                    tools:ignore="SmallSp" />
            </LinearLayout>

            <!-- 底部页脚：分隔线 + 本周已完成 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/widget_v2_ring"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_week_done"
                android:textSize="10sp"
                android:textColor="@color/widget_v2_text_secondary"
                android:layout_marginTop="5dp"
                tools:ignore="SmallSp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
