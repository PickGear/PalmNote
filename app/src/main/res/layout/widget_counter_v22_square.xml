<?xml version="1.0" encoding="utf-8"?>
<!--
  计数器 2×2（v22 SQUARE）：hd(徽章+计数) / hero 当前/目标 / 八点排 2×4 / 差额与副计数一行。
  点走 addView(widget_v22_dotg)（目标值 ≤8 才画）；底行左「还差 N 杯」右「副计数 · 副计数」。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/widget_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="13dp"
        android:paddingVertical="13dp"
        android:background="@drawable/widget_card_round">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="@dimen/widget_v22_badge_sm"
                android:layout_height="@dimen/widget_v22_badge_sm">

                <ImageView
                    android:id="@+id/widget_counter_badge"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_shape_circle"
                    android:contentDescription="@null" />

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_gravity="center"
                    android:src="@drawable/widget_ic_hash_white"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_counter_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="@string/widget_counter_title_short"
                android:textSize="@dimen/widget_v22_text_ttl"
                android:textStyle="bold"
                android:textColor="@color/widget_v22_text_1"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_counter_hero"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="0/0"
            android:textSize="@dimen/widget_v22_text_hero"
            android:textStyle="bold"
            android:textColor="@color/widget_v22_text_1"
            android:maxLines="1"
            android:includeFontPadding="false" />

        <!-- 八点 2×4 宿主：addView(widget_v22_dotg)，目标值 >8 时整行 GONE -->
        <LinearLayout
            android:id="@+id/widget_counter_dots_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/widget_counter_meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="@dimen/widget_v22_text_lb"
                android:textColor="@color/widget_v22_text_2"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_counter_subs_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textSize="@dimen/widget_v22_text_lb"
                android:textColor="@color/widget_v22_text_2"
                android:maxLines="1"
                android:ellipsize="start"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_counter_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/widget_no_goals"
            android:textSize="@dimen/widget_v22_text_lb"
            android:textColor="@color/widget_v22_text_2"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
