<?xml version="1.0" encoding="utf-8"?>
<!--
  物品 3×2（v4 定稿）：头部（徽章 + 物品分布 + Hero「N 件」——20sp 大数字 + 小单位）
  → 顶部占比条（10dp，按分类占比分组，组间 3dp 缝 + 4dp 圆头）
  → 两列色片网格（淡彩胶囊底 + 同族色点 + 分类名 + 纯数字件数，件数着同族色）。

  RemoteViews 不能运行时改子控件宽度，所以占比条的各段只能等宽：段数 = 24 个固定槽位，
  「占几段」表达比例，组的首/末段换圆头 drawable、组首段内缩出缝；
  每类到底几件，由下面的色片写清楚。
  色片的淡彩底与色点都是白底占位，运行时 setColorFilter 上色（静态默认不可见，别删这两层）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/widget_pad"
    android:background="@drawable/widget_card_round">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="@dimen/widget_icon_badge"
            android:layout_height="@dimen/widget_icon_badge">

            <ImageView
                android:id="@+id/widget_asset_badge"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_shape_circle"
                android:contentDescription="@null" />

            <ImageView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_gravity="center"
                android:src="@drawable/widget_ic_box_white"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_asset_title"
            android:textSize="@dimen/widget_text_title"
            android:textColor="@color/widget_v2_text_primary"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />

        <!-- Hero Number：总数大字 + 单位（v4：总数是这张卡的主信息） -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextView
                android:id="@+id/widget_asset_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textColor="@color/widget_v2_text_primary"
                android:textStyle="bold"
                android:lineSpacingExtra="0dp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_asset_total_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_asset_unit"
                android:textSize="@dimen/widget_text_label"
                android:textColor="@color/widget_v2_text_tertiary"
                android:layout_marginStart="3dp"
                android:layout_marginBottom="1dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 占比条：24 段等宽槽位，按件数占比分给各分类 —— 段的宽度于是就是比例；
         分组首/末段用圆头 drawable 出 4dp 圆角，非首组首段左内缩 3dp 形成分组间的缝
         （容器无底色，缝里露出的是卡底，与设计 .seg 的 gap 一致） -->
    <LinearLayout
        android:id="@+id/widget_asset_bar"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <ImageView
            android:id="@+id/widget_asset_seg_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/widget_seg_slot_flat"
            android:contentDescription="@null" />
