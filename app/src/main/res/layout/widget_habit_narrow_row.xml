<?xml version="1.0" encoding="utf-8"?>
<!--
  习惯 1×3 竖条的行：名称压到一行 + 近 7 天小方柱（7dp）。今天那格由 Provider 上色，
  其余按打卡状态上色族色 / 轨道灰。整行是打卡热区。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_habit_narrow_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="5dp">

    <TextView
        android:id="@+id/widget_habit_narrow_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/widget_v2_text_primary"
        android:maxLines="1"
        android:ellipsize="end" />

    <ImageView
        android:id="@+id/widget_habit_narrow_dot_0"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_marginStart="2dp"
        android:src="@drawable/widget_sq_dot"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/widget_habit_narrow_dot_1"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_marginStart="2dp"
        android:src="@drawable/widget_sq_dot"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/widget_habit_narrow_dot_2"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_marginStart="2dp"
        android:src="@drawable/widget_sq_dot"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/widget_habit_narrow_dot_3"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_marginStart="2dp"
        android:src="@drawable/widget_sq_dot"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/widget_habit_narrow_dot_4"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_marginStart="2dp"
        android:src="@drawable/widget_sq_dot"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/widget_habit_narrow_dot_5"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_marginStart="2dp"
        android:src="@drawable/widget_sq_dot"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/widget_habit_narrow_dot_6"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_marginStart="2dp"
        android:src="@drawable/widget_sq_dot"
        android:contentDescription="@null" />

</LinearLayout>
