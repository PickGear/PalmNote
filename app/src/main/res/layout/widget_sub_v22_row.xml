<?xml version="1.0" encoding="utf-8"?>
<!--
  v22 订阅行（稿 s42：日期在外、金额在内）：左侧日期列 + 右侧胶囊（色点 + 名称 + 金额）。
  胶囊走 widget_v22_chip（0dp+weight 1 吃掉行内剩余宽度）；日期列宽固定，右对齐到胶囊。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_sub_row"
    android:layout_width="match_parent"
    android:layout_height="@dimen/widget_v22_chip_h"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="5dp">

    <TextView
        android:id="@+id/widget_sub_row_date"
        android:layout_width="38dp"
        android:layout_height="wrap_content"
        android:textSize="@dimen/widget_v22_text_lb"
        android:textColor="@color/widget_v22_text_2"
        android:maxLines="1" />

    <LinearLayout
        android:id="@+id/widget_sub_row_chip_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:layout_marginStart="8dp" />
</LinearLayout>
