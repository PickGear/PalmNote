<?xml version="1.0" encoding="utf-8"?>
<!--
  待办 4×2（v22 WIDE）：hd(徽章+待办+今天 N/M) / 三行可点胶囊（勾选框/事项/时间）。
  行走 addView(widget_todo_v22_row)，行间 5dp；不足三行不补位（素清单，留白即「今天事不多」）。
  点行进生活页今日安排，点卡片整卡同目标。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/widget_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="15dp"
        android:paddingVertical="13dp"
        android:background="@drawable/widget_card_round">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="@dimen/widget_v22_badge"
                android:layout_height="@dimen/widget_v22_badge">

                <ImageView
                    android:id="@+id/widget_todo_badge"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_shape_circle"
                    android:contentDescription="@null" />

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_gravity="center"
                    android:src="@drawable/widget_ic_check_white"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_todo_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:text="@string/widget_todo_title_short"
                android:textSize="@dimen/widget_v22_text_ttl"
                android:textStyle="bold"
                android:textColor="@color/widget_v22_text_1"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_todo_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/widget_v22_text_lb"
                android:textColor="@color/widget_v22_text_2"
                android:maxLines="1" />
        </LinearLayout>

        <!-- 清单宿主：addView(widget_todo_v22_row) × ≤3 -->
        <LinearLayout
            android:id="@+id/widget_todo_rows_host"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/widget_todo_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/widget_todo_empty_today"
            android:textSize="@dimen/widget_v22_text_lb"
            android:textColor="@color/widget_v22_text_2"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
