<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/widget_card_round">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_sc_add"
            android:contentDescription="@string/widget_add_bill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_card_teal">

            <TextView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:text="+"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/widget_v2_accent"
                android:gravity="center"
                android:background="@drawable/widget_circle_white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/widget_add_bill"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:singleLine="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_sc_bill"
            android:contentDescription="@string/widget_shortcut_bills"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_soft_card"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:text="¥"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/widget_v2_accent"
                android:gravity="center"
                android:background="@drawable/widget_chip_soft_cyan" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/widget_shortcut_bills"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/widget_v2_text_primary"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:id="@+id/widget_sc_todo"
            android:contentDescription="@string/widget_todos_label"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_soft_card">

            <TextView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:text="✓"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/widget_v2_accent"
                android:gravity="center"
                android:background="@drawable/widget_chip_soft_cyan" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/widget_todos_label"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/widget_v2_text_primary"
                android:singleLine="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_sc_vault"
            android:contentDescription="@string/widget_vault_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_soft_card"
            android:layout_marginStart="8dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/widget_ic_lock_dark"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/widget_vault_title"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/widget_v2_text_primary"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
