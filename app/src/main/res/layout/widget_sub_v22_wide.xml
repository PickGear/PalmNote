<?xml version="1.0" encoding="utf-8"?>
<!--
  订阅 4×2（v22 WIDE）：hd(徽章+订阅提醒+hero 本月合计) / 三行待扣（日期在外 + 胶囊在内）。
  行走 addView(widget_sub_v22_row)，胶囊再 addView(widget_v22_chip)；行色按行位取族色。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/widget_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="15dp"
        android:paddingVertical="13dp"
        android:background="@drawable/widget_card_round">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="@dimen/widget_v22_badge"
                android:layout_height="@dimen/widget_v22_badge">

                <ImageView
                    android:id="@+id/widget_subscription_badge"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_shape_circle"
                    android:contentDescription="@null" />

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_gravity="center"
                    android:src="@drawable/widget_ic_refresh_white"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_subscription_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:text="@string/widget_subscription_title"
                android:textSize="@dimen/widget_v22_text_ttl"
                android:textStyle="bold"
                android:textColor="@color/widget_v22_text_1"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_subscription_month_sum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/widget_v22_text_hero_sm"
                android:textStyle="bold"
                android:textColor="@color/widget_v22_text_1"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 待扣行宿主：addView(widget_sub_v22_row) × ≤3 -->
        <LinearLayout
            android:id="@+id/widget_subscription_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/widget_subscription_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/widget_subscription_empty"
            android:textSize="@dimen/widget_v22_text_lb"
            android:textColor="@color/widget_v22_text_2"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
