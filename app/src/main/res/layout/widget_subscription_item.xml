<?xml version="1.0" encoding="utf-8"?>
<!--
  订阅时间轴的一行：色点（落在竖线上）+ 日期 + 名称 + 金额。
  色点与金额运行时着该行的色族色（金额直接着在文字上）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_subscription_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="5dp">

    <ImageView
        android:id="@+id/widget_subscription_item_dot"
        android:layout_width="9dp"
        android:layout_height="9dp"
        android:src="@drawable/widget_shape_circle"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/widget_subscription_item_date"
        android:layout_width="34dp"
        android:layout_height="wrap_content"
        android:textSize="@dimen/widget_text_micro"
        android:textColor="@color/widget_v2_text_tertiary"
        android:layout_marginStart="6dp"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_subscription_item_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="12sp"
        android:textColor="@color/widget_v2_text_primary"
        android:textStyle="bold"
        android:layout_marginStart="6dp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_subscription_item_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginStart="6dp"
        android:maxLines="1" />

</LinearLayout>
