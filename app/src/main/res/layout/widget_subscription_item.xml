<?xml version="1.0" encoding="utf-8"?>
<!--
  订阅时间轴的一行（v4）：独立日期列（右对齐，最近一笔着警示族色）
  + 色底 chip 行（色点 + 名称 + 「即将扣费」标签 + 金额）。
  chip 底、色点、标签与金额运行时着该行色族色；「即将扣费」只在 ≤3 天时显示。
-->
<!-- 行高走 weight 均分（稿 .trow{flex:1;min-height:0}）：4 行等分卡内余高，
     不会因头部 Hero 行高把最后一行挤出卡外 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_subscription_row"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="2dp">

    <TextView
        android:id="@+id/widget_subscription_item_date"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/widget_v2_text_secondary"
        android:gravity="right"
        android:maxLines="1" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="6dp">

        <ImageView
            android:id="@+id/widget_subscription_item_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_row_round"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="9dp"
            android:paddingVertical="1dp">

            <ImageView
                android:id="@+id/widget_subscription_item_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:src="@drawable/widget_shape_circle"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_subscription_item_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="@color/widget_v2_text_primary"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_subscription_item_upcoming"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/widget_text_label"
                android:textStyle="bold"
                android:text="@string/widget_subscription_upcoming"
                android:layout_marginStart="4dp"
                android:visibility="gone"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_subscription_item_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:includeFontPadding="false"
                android:textStyle="bold"
                android:layout_marginStart="4dp"
                android:maxLines="1" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
