<?xml version="1.0" encoding="utf-8"?>
<!--
  待办 2×2（v22 SQUARE）：hd(徽章+待办+今天 N/M) / hero「N 项」/ 三行素清单（勾选框/事项/时间）。
  素行走 addView(widget_todo_v22_trow)，行间 4dp；hero 与清单各吃一半剩余高度并居中，
  36sp 大数字在 Android 下比稿内 36px 高约 6dp，靠两个 weight 宿主摊掉，不缩字号。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/widget_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="13dp"
        android:paddingVertical="13dp"
        android:background="@drawable/widget_card_round">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="@dimen/widget_v22_badge_sm"
                android:layout_height="@dimen/widget_v22_badge_sm">

                <ImageView
                    android:id="@+id/widget_todo_badge"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_shape_circle"
                    android:contentDescription="@null" />

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_gravity="center"
                    android:src="@drawable/widget_ic_check_white"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_todo_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:text="@string/widget_todo_title_short"
                android:textSize="@dimen/widget_v22_text_ttl"
                android:textStyle="bold"
                android:textColor="@color/widget_v22_text_1"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_todo_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/widget_v22_text_lb"
                android:textColor="@color/widget_v22_text_2"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_todo_hero"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="0"
            android:textSize="@dimen/widget_v22_text_hero"
            android:textStyle="bold"
            android:textColor="@color/widget_v22_text_1"
            android:maxLines="1"
            android:includeFontPadding="false" />

        <!-- 清单宿主：addView(widget_todo_v22_trow) × ≤3 -->
        <LinearLayout
            android:id="@+id/widget_todo_rows_host"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/widget_todo_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/widget_todo_empty_today"
            android:textSize="@dimen/widget_v22_text_lb"
            android:textColor="@color/widget_v22_text_2"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
