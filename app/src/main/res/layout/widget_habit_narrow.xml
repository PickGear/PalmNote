<?xml version="1.0" encoding="utf-8"?>
<!--
  习惯 1×3 竖条（v4）：窄列只放数字流 —— 「N 项习惯 + 1/4」→ 每行「名称 + 近 7 天方柱」
  → 底部「本周 P%」。宽度 <150dp 时由 Provider 切到此布局。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="12dp"
    android:background="@drawable/widget_card_round">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_habit_narrow_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="@dimen/widget_text_micro"
            android:textColor="@color/widget_v2_text_secondary"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_habit_narrow_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/widget_text_micro"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_habit_narrow_rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_v2_ring" />

    <TextView
        android:id="@+id/widget_habit_narrow_week"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="6dp"
        android:textSize="@dimen/widget_text_micro"
        android:textColor="@color/widget_v2_text_secondary"
        android:maxLines="1" />

</LinearLayout>
