<?xml version="1.0" encoding="utf-8"?>
<!--
  习惯周历的一行（v4 方柱版）：左习惯名（64dp 省略）+ 近 7 天方柱（18dp，从 6 天前排到今天）
  + 行尾本周完成 x/7。整行可点 = 给这个习惯打今天的卡。
  行高按网格均分（0dp + weight，稿子 grid-auto-rows:1fr），行内不再留 padding ——
  今天那格的淡底（.tc）靠满行高首尾相接，从列头一路贯穿到最后一行（.tcb 下圆角）。
  今天未打卡时方柱隐藏，原位给虚线环（稿子 1.5dp 虚线描边、内部透明）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_habit_dots_row"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/widget_habit_row_name"
        android:layout_width="62dp"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/widget_v2_text_primary"
        android:maxLines="1"
        android:ellipsize="end" />

    <ImageView
        android:id="@+id/widget_habit_dot_0"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="5dp"
        android:src="@drawable/widget_sq_dot"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/widget_habit_dot_1"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="5dp"
        android:src="@drawable/widget_sq_dot"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/widget_habit_dot_2"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="5dp"
        android:src="@drawable/widget_sq_dot"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/widget_habit_dot_3"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="5dp"
        android:src="@drawable/widget_sq_dot"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/widget_habit_dot_4"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="5dp"
        android:src="@drawable/widget_sq_dot"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/widget_habit_dot_5"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="5dp"
        android:src="@drawable/widget_sq_dot"
        android:contentDescription="@null" />

    <!-- 今天列：满行高淡底（中段直角、最后一行下圆角）+ 方柱/虚线环 -->
    <FrameLayout
        android:layout_width="24dp"
        android:layout_height="match_parent"
        android:layout_marginStart="4dp">

        <ImageView
            android:id="@+id/widget_habit_dot_today_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_col_mid"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/widget_habit_dot_6"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/widget_sq_dot"
            android:contentDescription="@null" />

        <!-- 今天未打卡：方柱换成同位虚线环（运行时着文字三级色） -->
        <ImageView
            android:id="@+id/widget_habit_dot_today_ring"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/widget_sq_dashed"
            android:visibility="gone"
            android:contentDescription="@null" />
    </FrameLayout>

    <TextView
        android:id="@+id/widget_habit_row_week"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/widget_v2_text_secondary"
        android:maxLines="1" />
</LinearLayout>
