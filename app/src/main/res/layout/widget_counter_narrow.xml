<?xml version="1.0" encoding="utf-8"?>
<!--
  倒计时 1×2 竖条（v4）：窄列只放数字流 —— 徽章 / 大数字「20 天」/ 事件名 / 日期·星期。
  宽度 <150dp 且高度 <180dp 时由 Provider 切到此布局。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingHorizontal="10dp"
    android:paddingVertical="12dp"
    android:background="@drawable/widget_card_round">

    <LinearLayout
        android:id="@+id/widget_counter_narrow_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <FrameLayout
            android:layout_width="26dp"
            android:layout_height="26dp">

            <ImageView
                android:id="@+id/widget_counter_narrow_badge"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_chip_round"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_counter_narrow_badge_icon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="center"
                android:src="@drawable/widget_ic_calendar_white"
                android:contentDescription="@null" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/widget_counter_narrow_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="30sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_days_label"
                android:textSize="@dimen/widget_text_micro"
                android:textColor="@color/widget_v2_text_secondary"
                android:layout_marginStart="2dp"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_counter_narrow_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/widget_v2_text_primary"
            android:layout_marginTop="6dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_counter_narrow_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/widget_text_micro"
            android:textColor="@color/widget_v2_text_secondary"
            android:layout_marginTop="2dp"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_counter_narrow_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_counter_empty"
        android:textSize="@dimen/widget_text_micro"
        android:textColor="@color/widget_v2_text_tertiary"
        android:gravity="center"
        android:visibility="gone"
        android:maxLines="2" />

</LinearLayout>
