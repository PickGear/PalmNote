<?xml version="1.0" encoding="utf-8"?>
<!--
  v22 胶囊 · 自适应宽（稿 .ch.sm 无 flex：胶囊按内容收窄、左对齐排列，间隙 6dp）。
  与 widget_v22_chip 同构，唯独根宽度 wrap_content（chip 是 0dp+weight 等分撑满）——
  计数器 4×2 的副计数用：两枚小胶囊靠左排，不摊满整行。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_v22_chip_root"
    android:layout_width="wrap_content"
    android:layout_height="26dp"
    android:layout_marginEnd="6dp">

    <ImageView
        android:id="@+id/widget_v22_chip_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_v22_round10"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="9dp">

        <ImageView
            android:id="@+id/widget_v22_chip_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:src="@drawable/widget_shape_circle"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_v22_chip_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/widget_v22_text_1"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_v22_chip_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="12sp"
            android:textColor="@color/widget_v22_text_2"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_v22_chip_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/widget_v22_text_1"
            android:maxLines="1"
            android:includeFontPadding="false" />
    </LinearLayout>
</FrameLayout>
