<?xml version="1.0" encoding="utf-8"?>
<!--
  习惯组件的选择器静态预览（`previewLayout`，Android 12+）：直接贴同源 `previewImage`。
  系统 inflate 这个布局时**不跑应用代码**，所以不能放运行时布局（`widget_habit_unified` 的文本与
  方柱全靠 Provider 填，静态下会是空壳 + 截断）。贴 PNG 后「系统选择器 / 确认框 / App 内目录」
  三处看到的是同一张图，与账单 / 总资产等其它组件同一处理方式。
  PNG 由 `WidgetPreviewPngGenerator` 从运行时布局离屏渲染，改运行时布局后需重出。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_preview_habit"
        android:contentDescription="@null" />
</FrameLayout>
