<?xml version="1.0" encoding="utf-8"?>
<!--
  习惯 4×3（v4 方柱周历）：Hero 连击（连击最长的习惯）+ 近 7 天方柱矩阵
  （列头日期、今天列方环、行尾本周 x/7）+ 底部三指标（最长连击/本周完成率/今日待打卡）。
  点阵行仍是打卡热区，行由 Provider 动态添加。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/widget_pad"
    android:background="@drawable/widget_card_round">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="@dimen/widget_icon_badge"
            android:layout_height="@dimen/widget_icon_badge">

            <ImageView
                android:id="@+id/widget_habit_badge"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_shape_circle"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="✓"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF"
                android:gravity="center" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_habit_title"
            android:textSize="@dimen/widget_text_title"
            android:textColor="@color/widget_v2_text_primary"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/widget_habit_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_habit_count_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_habit_done_label"
                android:textSize="@dimen/widget_text_micro"
                android:textColor="@color/widget_v2_text_secondary"
                android:layout_marginTop="1dp"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hero：连击数字 + 习惯名/副标（距离最长记录还差 X 天）+ 最右本月打卡 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/widget_habit_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="40sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:maxLines="1" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/widget_habit_streak_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/widget_v2_text_primary"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_habit_streak_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/widget_text_micro"
                android:textColor="@color/widget_v2_text_secondary"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- 最右：本月打卡天数（Hero 那个习惯的本月口径），无习惯时整块隐藏 -->
        <LinearLayout
            android:id="@+id/widget_habit_month_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginStart="8dp"
            android:paddingBottom="3dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_habit_month_label"
                android:textSize="@dimen/widget_text_micro"
                android:textColor="@color/widget_v2_text_secondary"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_habit_month_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/widget_v2_text_secondary"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- 近 7 天列头：日期数字，今天上胶囊 -->
    <include
        android:id="@+id/widget_habit_weekhead"
        layout="@layout/widget_habit_weekhead"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <!-- 方柱矩阵：一行一个习惯（Provider 动态添加），整行是打卡热区 -->
    <LinearLayout
        android:id="@+id/widget_habit_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical" />

    <!-- 底部三指标 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/widget_habit_stat_longest"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="@dimen/widget_text_micro"
            android:textColor="@color/widget_v2_text_secondary"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_habit_stat_week"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="@dimen/widget_text_micro"
            android:textColor="@color/widget_v2_text_secondary"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_habit_stat_todo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="right"
            android:textSize="@dimen/widget_text_micro"
            android:textColor="@color/widget_v2_text_secondary"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_habit_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="@string/widget_habit_empty"
        android:textSize="12sp"
        android:textColor="@color/widget_v2_text_tertiary"
        android:gravity="center"
        android:visibility="gone" />

</LinearLayout>
