<?xml version="1.0" encoding="utf-8"?>
<!--
  物品 2×2（v22 SQUARE）：hd(徽章+物品+hero) / 分段条 / 2 列图例三行 / 「最多」行。
  与 4×2 的差别：3 列 → 2 列（胶囊走紧版 tight），末格可以是「+N」聚合槽；
  分类 ≤4 时第三行腾空，改显「最多 分类名 N」行（稿口径）。
  行高 26（稿 .ch.sm.tight 同高），行间 5dp。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/widget_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="13dp"
        android:paddingVertical="13dp"
        android:background="@drawable/widget_card_round">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="@dimen/widget_v22_badge_sm"
                android:layout_height="@dimen/widget_v22_badge_sm">

                <ImageView
                    android:id="@+id/widget_asset_badge"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_shape_circle"
                    android:contentDescription="@null" />

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_gravity="center"
                    android:src="@drawable/widget_ic_box_white"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_asset_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:text="@string/widget_asset_title_short"
                android:textSize="@dimen/widget_v22_text_ttl"
                android:textStyle="bold"
                android:textColor="@color/widget_v22_text_1"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_asset_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/widget_v22_text_hero_sm"
                android:textStyle="bold"
                android:textColor="@color/widget_v22_text_1"
                android:maxLines="1"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- 分段条宿主：addView(widget_v22_seg) -->
        <LinearLayout
            android:id="@+id/widget_asset_seg_host"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:orientation="horizontal"
            android:layout_marginTop="5dp" />

        <!-- 图例网格宿主：addView(widget_asset_v22_row2 / _end) × 2~3 -->
        <LinearLayout
            android:id="@+id/widget_asset_grid_host"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layout_marginTop="5dp" />

        <!-- 「最多」行：分类 ≤4 才有（第三行腾空时补语义，不空跑） -->
        <LinearLayout
            android:id="@+id/widget_asset_most_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="5dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_asset_most_dot"
                android:layout_width="@dimen/widget_v22_dot_sm"
                android:layout_height="@dimen/widget_v22_dot_sm"
                android:src="@drawable/widget_shape_circle"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_asset_most_lbl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="@string/widget_asset_label_most"
                android:textSize="@dimen/widget_v22_text_lb"
                android:textColor="@color/widget_v22_text_2"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_asset_most_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:textSize="@dimen/widget_v22_text_lb"
                android:textStyle="bold"
                android:textColor="@color/widget_v22_text_1"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_asset_most_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:textSize="@dimen/widget_v22_text_val"
                android:textStyle="bold"
                android:textColor="@color/widget_v22_text_1"
                android:maxLines="1"
                android:includeFontPadding="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_asset_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/widget_asset_empty"
            android:textSize="@dimen/widget_v22_text_lb"
            android:textColor="@color/widget_v22_text_2"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
