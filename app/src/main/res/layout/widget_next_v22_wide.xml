<?xml version="1.0" encoding="utf-8"?>
<!--
  接下来 4×2（v22 WIDE）：hd(徽章+接下来+自动轮转) / hero「N 天」+ 倒计时进度条 / 事件说明行。
  进度条 = 从建项到目标日已过去的比例（建项当天或算不出时整条收起，不画假比例）；
  说明行 = 事件名 · 日期 · [提醒 HH:mm] · 星期（缺的段自动省）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/widget_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="15dp"
        android:paddingVertical="13dp"
        android:background="@drawable/widget_card_round">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="@dimen/widget_v22_badge"
                android:layout_height="@dimen/widget_v22_badge">

                <ImageView
                    android:id="@+id/widget_next_badge"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_shape_circle"
                    android:contentDescription="@null" />

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_gravity="center"
                    android:src="@drawable/widget_ic_clock_white"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_next_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:text="@string/widget_next_up_title"
                android:textSize="@dimen/widget_v22_text_ttl"
                android:textStyle="bold"
                android:textColor="@color/widget_v22_text_1"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_next_rotate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_next_up_rotate"
                android:textSize="@dimen/widget_v22_text_lb"
                android:textColor="@color/widget_v22_text_2"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_next_hero"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="0"
            android:textSize="@dimen/widget_v22_text_hero_lg"
            android:textStyle="bold"
            android:textColor="@color/widget_v22_text_1"
            android:maxLines="1"
            android:includeFontPadding="false" />

        <!-- 倒计时进度条：track 静态 line 轨 + fill clip（运行时上族色、level 定宽度） -->
        <FrameLayout
            android:id="@+id/widget_next_prog"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="6dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_next_prog_track"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_v22_prog_track"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_next_prog_fill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_bar_fill"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:id="@+id/widget_next_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:textSize="@dimen/widget_v22_text_lb"
            android:textColor="@color/widget_v22_text_2"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_next_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/widget_next_up_empty"
            android:textSize="@dimen/widget_v22_text_lb"
            android:textColor="@color/widget_v22_text_2"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
