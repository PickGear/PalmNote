<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_habit_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="6dp">

    <FrameLayout
        android:layout_width="18dp"
        android:layout_height="18dp">

        <!-- 未打卡：灰环（固定色，不随主题） -->
        <ImageView
            android:id="@+id/widget_habit_check_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_ring_gray"
            android:contentDescription="@null" />

        <!-- 已打卡：可着色圆底（setColorFilter 运行时取主题色） -->
        <ImageView
            android:id="@+id/widget_habit_check_fill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_shape_circle"
            android:visibility="gone"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_habit_check"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center" />
    </FrameLayout>

    <TextView
        android:id="@+id/widget_habit_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="13sp"
        android:textColor="@color/widget_v2_text_primary"
        android:layout_marginStart="8dp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_habit_streak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textColor="#F97316"
        android:layout_marginStart="6dp" />

</LinearLayout>
