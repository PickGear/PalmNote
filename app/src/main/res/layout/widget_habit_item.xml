<?xml version="1.0" encoding="utf-8"?>
<!--
  习惯组件的一行：圆圈（打卡热区）+ 名称 + **近 7 天圆点** + 连击天数。
  圆点是这行的主角图形：已打卡着主题色、未打卡着中性灰，横向对齐成网格
  （所以名称给固定宽度，各行的点才能对齐成一列一列）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_habit_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="8dp">

    <FrameLayout
        android:layout_width="18dp"
        android:layout_height="18dp">

        <!-- 未打卡：灰环（固定色，不随主题） -->
        <ImageView
            android:id="@+id/widget_habit_check_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_ring_gray"
            android:contentDescription="@null" />

        <!-- 已打卡：可着色圆底（setColorFilter 运行时取主题色） -->
        <ImageView
            android:id="@+id/widget_habit_check_fill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_shape_circle"
            android:visibility="gone"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_habit_check"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center" />
    </FrameLayout>

    <!-- 固定宽度：各行的圆点靠它对齐成一列 -->
    <TextView
        android:id="@+id/widget_habit_name"
        android:layout_width="104dp"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/widget_v2_text_primary"
        android:layout_marginStart="8dp"
        android:maxLines="1"
        android:ellipsize="end" />

    <ImageView
        android:id="@+id/widget_habit_dot_0"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/widget_shape_circle"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/widget_habit_dot_1"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="6dp"
        android:src="@drawable/widget_shape_circle"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/widget_habit_dot_2"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="6dp"
        android:src="@drawable/widget_shape_circle"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/widget_habit_dot_3"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="6dp"
        android:src="@drawable/widget_shape_circle"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/widget_habit_dot_4"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="6dp"
        android:src="@drawable/widget_shape_circle"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/widget_habit_dot_5"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="6dp"
        android:src="@drawable/widget_shape_circle"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/widget_habit_dot_6"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="6dp"
        android:src="@drawable/widget_shape_circle"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/widget_habit_streak"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="@dimen/widget_text_micro"
        android:textColor="@color/widget_v2_text_secondary"
        android:gravity="end"
        android:layout_marginStart="6dp"
        android:maxLines="1" />

</LinearLayout>
