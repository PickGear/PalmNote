<?xml version="1.0" encoding="utf-8"?>
<!--
  「接下来」焦点卡（3×2，v4 定稿）：一张卡只放一件事。
  头部：徽标 + 「接下来」+ 右上「自动轮转」；
  主体：一张大色底 chip —— 第一行 类型标签（+ 待办的「完成」胶囊动作），
  第二行 标题 + 大字数值（右端），第三行 时效说明（今天到期 / M/d 扣费 / 目标日期）。
  行内容与配色全部由 Provider 按条目类型（待办/订阅/倒数）填。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/widget_pad"
    android:background="@drawable/widget_card_round">

    <LinearLayout
        android:id="@+id/widget_next_up_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="@dimen/widget_icon_badge"
                android:layout_height="@dimen/widget_icon_badge">

                <ImageView
                    android:id="@+id/widget_next_up_badge"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_shape_circle"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/widget_next_up_badge_icon"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_gravity="center"
                    android:src="@drawable/widget_ic_check_white"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/widget_next_up_title"
                android:textSize="@dimen/widget_text_title"
                android:textColor="@color/widget_v2_text_primary"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_next_up_rotate"
                android:textSize="@dimen/widget_text_label"
                android:textColor="@color/widget_v2_text_tertiary" />
        </LinearLayout>

        <!-- 主体大 chip：底色由 Provider 着该条目类型的色族淡色 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp">

            <ImageView
                android:id="@+id/widget_next_up_chip_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_chip_round"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/widget_next_up_chip_dot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:src="@drawable/widget_shape_circle"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/widget_next_up_kind"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:textSize="@dimen/widget_text_label"
                        android:textColor="@color/widget_v2_text_tertiary" />

                    <Button
                        android:id="@+id/widget_next_up_action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:background="@drawable/widget_pill_action"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="4dp"
                        android:text="@string/widget_next_up_done"
                        android:textSize="@dimen/widget_text_micro"
                        android:textColor="#FFFFFFFF"
                        android:textStyle="bold"
                        android:visibility="gone"
                        android:contentDescription="@string/widget_next_up_done" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/widget_next_up_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="14sp"
                        android:textColor="@color/widget_v2_text_primary"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/widget_next_up_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_next_up_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="@dimen/widget_text_label"
                    android:textColor="@color/widget_v2_text_tertiary" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_next_up_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/widget_next_up_empty"
        android:textSize="@dimen/widget_text_micro"
        android:textColor="@color/widget_v2_text_secondary"
        android:visibility="gone" />
</LinearLayout>
