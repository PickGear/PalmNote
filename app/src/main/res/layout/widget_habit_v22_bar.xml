<?xml version="1.0" encoding="utf-8"?>
<!--
  打卡 4×1（v22 BAR）：徽章+今日打卡 | 三列读数（今日 x/y + 刻度 / 连续 N 天 / 焦点习惯 x/7 + 刻度）
  | —— 打卡 4×1 没有进度条：两个刻度本身就是可视化（稿口径）。
  今日列的刻度一格 = 一个习惯（分母 = 习惯数，>7 收起刻度行）；焦点习惯列恒 7 格（本周）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/widget_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingHorizontal="15dp"
        android:paddingVertical="9dp"
        android:background="@drawable/widget_card_round">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="@dimen/widget_v22_badge_sm"
                android:layout_height="@dimen/widget_v22_badge_sm">

                <ImageView
                    android:id="@+id/widget_habit_badge"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_shape_circle"
                    android:contentDescription="@null" />

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_gravity="center"
                    android:src="@drawable/widget_ic_calendar_white"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_habit_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="@string/widget_habit_title"
                android:textSize="@dimen/widget_v22_text_ttl"
                android:textStyle="bold"
                android:textColor="@color/widget_v22_text_1"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:layout_marginStart="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_habit_bar_today_lbl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_habit_label_today"
                        android:textSize="@dimen/widget_v22_text_micro"
                        android:textColor="@color/widget_v22_text_2"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/widget_habit_bar_today"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0/0"
                        android:textSize="@dimen/widget_v22_text_val"
                        android:textStyle="bold"
                        android:textColor="@color/widget_v22_text_1"
                        android:maxLines="1"
                        android:includeFontPadding="false" />

                    <!-- 今日刻度宿主：addView(widget_v22_ticks)，一格 = 一个习惯 -->
                    <LinearLayout
                        android:id="@+id/widget_habit_bar_today_ticks"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:orientation="horizontal"
                        android:layout_marginTop="3dp"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:id="@+id/widget_habit_bar_streak_lbl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_habit_label_streak"
                        android:textSize="@dimen/widget_v22_text_micro"
                        android:textColor="@color/widget_v22_text_2"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/widget_habit_bar_streak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="@dimen/widget_v22_text_val"
                        android:textStyle="bold"
                        android:textColor="@color/widget_v22_text_1"
                        android:maxLines="1"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:id="@+id/widget_habit_bar_top_lbl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/widget_v22_text_micro"
                        android:textColor="@color/widget_v22_text_2"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/widget_habit_bar_top"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0/7"
                        android:textSize="@dimen/widget_v22_text_val"
                        android:textStyle="bold"
                        android:textColor="@color/widget_v22_text_1"
                        android:maxLines="1"
                        android:includeFontPadding="false" />

                    <!-- 焦点习惯刻度宿主：addView(widget_v22_ticks)，恒 7 格（本周） -->
                    <LinearLayout
                        android:id="@+id/widget_habit_bar_top_ticks"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:orientation="horizontal"
                        android:layout_marginTop="3dp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
