<?xml version="1.0" encoding="utf-8"?>
<!--
  待办色片（清单一行）：淡彩胶囊底 + 同族色点 + 标题 + 到期说明。底与色点都是白底占位，
  运行时 setColorFilter 上该条目的色族色；完成的行用划线 + 三级色文字区分。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_todo_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/widget_todo_chip_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_chip_round"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp">

        <ImageView
            android:id="@+id/widget_todo_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:src="@drawable/widget_shape_circle"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_item_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="@color/widget_v2_text_primary"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_item_due"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/widget_text_micro"
            android:textColor="@color/widget_v2_text_tertiary"
            android:layout_marginStart="4dp"
            android:maxLines="1" />
    </LinearLayout>
</FrameLayout>
