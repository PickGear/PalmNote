<?xml version="1.0" encoding="utf-8"?>
<!--
  倒计时 1×3 竖条（v4）：「生活计数」+ 三条事件纵向数字流（名称 / N 天），细分隔线隔开。
  宽度 <150dp 且高度 ≥180dp 时由 Provider 切到此布局；事件不足三条时多余块收起。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="12dp"
    android:background="@drawable/widget_card_round">

    <TextView
        android:id="@+id/widget_counter_tall_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/widget_life_count_title"
        android:textSize="@dimen/widget_text_label"
        android:textColor="@color/widget_v2_text_tertiary"
        android:maxLines="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/widget_counter_tall_block_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/widget_counter_tall_name_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/widget_v2_text_primary"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_counter_tall_days_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_counter_tall_div_0"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="6dp"
            android:background="@color/widget_v2_ring"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/widget_counter_tall_block_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_counter_tall_name_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/widget_v2_text_primary"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_counter_tall_days_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_counter_tall_div_1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="6dp"
            android:background="@color/widget_v2_ring"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/widget_counter_tall_block_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_counter_tall_name_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/widget_v2_text_primary"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_counter_tall_days_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
