<?xml version="1.0" encoding="utf-8"?>
<!--
  待办 2×1 极简档（v4）：「今日待办 + 逾期胶囊 / 2 / 4 / 下一项」三行，只保 Hero。
  高度 <100dp 且宽度 <200dp 时由 Provider 切到此布局。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="8dp"
    android:background="@drawable/widget_card_round">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_todo_today"
            android:textSize="@dimen/widget_text_label"
            android:textColor="@color/widget_v2_text_tertiary"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_todo_min_overdue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_warn"
            android:textColor="@color/widget_risk_red"
            android:paddingHorizontal="7dp"
            android:paddingVertical="1dp"
            android:textSize="8sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:maxLines="1" />
    </LinearLayout>

    <!-- 数值行 weight=1 撑开剩余高度并垂直居中（稿 .w.s21 flex 列 space-between） -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/widget_todo_min_done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="@color/widget_v2_text_primary"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_todo_min_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="/0"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/widget_v2_text_tertiary"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_todo_min_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/widget_text_label"
        android:textColor="@color/widget_v2_text_tertiary"
        android:layout_marginTop="2dp"
        android:visibility="gone"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>
