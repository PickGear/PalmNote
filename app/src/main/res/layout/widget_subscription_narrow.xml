<?xml version="1.0" encoding="utf-8"?>
<!--
  订阅 1×2 竖条（v4）：窄列只放数字流 —— 徽章 / 本月合计 / 本月笔数 / 最近一笔。
  宽度 <150dp 时由 Provider 切到此布局。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingHorizontal="10dp"
    android:paddingVertical="12dp"
    android:background="@drawable/widget_card_round">

    <LinearLayout
        android:id="@+id/widget_subscription_narrow_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <FrameLayout
            android:layout_width="26dp"
            android:layout_height="26dp">

            <ImageView
                android:id="@+id/widget_subscription_narrow_badge"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_chip_round"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_subscription_narrow_badge_icon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="center"
                android:src="@drawable/widget_ic_refresh_white"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:id="@+id/widget_subscription_narrow_sum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/widget_v2_text_primary"
            android:layout_marginTop="6dp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_subscription_narrow_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/widget_text_micro"
            android:textColor="@color/widget_v2_text_secondary"
            android:layout_marginTop="2dp"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_subscription_narrow_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/widget_v2_text_primary"
            android:layout_marginTop="8dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_subscription_narrow_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/widget_text_micro"
            android:textColor="@color/widget_v2_text_secondary"
            android:layout_marginTop="2dp"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_subscription_narrow_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_subscription_empty"
        android:textSize="@dimen/widget_text_micro"
        android:textColor="@color/widget_v2_text_tertiary"
        android:gravity="center"
        android:visibility="gone"
        android:maxLines="2" />

</LinearLayout>
