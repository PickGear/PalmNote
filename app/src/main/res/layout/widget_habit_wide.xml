<?xml version="1.0" encoding="utf-8"?>
<!--
  习惯 4×1 横条（v4）：左「连续打卡 + 12 天」，中「今日 1/4 · 本周完成率 + 完成度条」，
  右「最长记录 / 21 天」。高度 <100dp 且宽度 ≥200dp 时由 Provider 切到此布局。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    android:background="@drawable/widget_card_round">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_habit_streak_label"
            android:textSize="@dimen/widget_text_label"
            android:textColor="@color/widget_v2_text_tertiary"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_habit_wide_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_habit_wide_today"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="@dimen/widget_text_micro"
                android:textColor="@color/widget_v2_text_secondary"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_habit_wide_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/widget_text_micro"
                android:textColor="@color/widget_v2_text_secondary"
                android:maxLines="1" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="5dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_bar_track"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_habit_wide_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_bar_fill"
                android:contentDescription="@null" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        android:layout_marginStart="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_longest_label"
            android:textSize="@dimen/widget_text_label"
            android:textColor="@color/widget_v2_text_tertiary"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_habit_wide_longest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/widget_v2_text_primary"
            android:layout_marginTop="2dp"
            android:maxLines="1" />
    </LinearLayout>

</LinearLayout>
