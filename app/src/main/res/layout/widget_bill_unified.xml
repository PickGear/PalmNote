<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_card_round">

    <!-- Header: icon + title + add pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/widget_ic_receipt"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_bill_title"
            android:textSize="15sp"
            android:textColor="@color/widget_v2_text_primary"
            android:textStyle="bold"
            android:layout_marginStart="6dp" />

        <TextView
            android:id="@+id/widget_add_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_add"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/widget_v2_accent"
            android:background="@drawable/widget_pill_soft"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <!-- Content -->
    <LinearLayout
        android:id="@+id/widget_content_with_data"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Income -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/widget_soft_card"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_income_label"
                    android:textSize="10sp"
                    android:textColor="@color/widget_v2_text_secondary" />

                <TextView
                    android:id="@+id/widget_income_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+0"
                    android:textSize="15sp"
                    android:textColor="@color/widget_v2_text_primary"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Expense -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/widget_soft_card"
                android:layout_marginStart="6dp"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_expense_label"
                    android:textSize="10sp"
                    android:textColor="@color/widget_v2_text_secondary" />

                <TextView
                    android:id="@+id/widget_expense_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-0"
                    android:textSize="15sp"
                    android:textColor="@color/widget_v2_text_primary"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Budget remaining -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/widget_soft_card_gray"
                android:layout_marginStart="6dp"
                android:padding="10dp">

                <TextView
                    android:id="@+id/widget_budget_card_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_budget_remaining"
                    android:textSize="10sp"
                    android:textColor="@color/widget_v2_text_secondary" />

                <TextView
                    android:id="@+id/widget_budget_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="15sp"
                    android:textColor="@color/widget_v2_text_primary"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Budget banner -->
        <LinearLayout
            android:id="@+id/widget_budget_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/widget_banner_accent"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:text="✓"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_v2_accent"
                    android:gravity="center"
                    android:background="@drawable/widget_circle_white" />

                <TextView
                    android:id="@+id/widget_budget_banner_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/widget_ic_chevron_white"
                    android:contentDescription="@null" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/widget_budget_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#FFFFFF"
                android:progressBackgroundTint="#33FFFFFF"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Empty -->
    <LinearLayout
        android:id="@+id/widget_empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_bill_empty"
            android:textSize="12sp"
            android:textColor="@color/widget_v2_text_tertiary" />
    </LinearLayout>

</LinearLayout>
