<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp"
    android:background="@drawable/widget_bg_glass">

    <!-- Accent bar -->
    <TextView
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:background="@drawable/widget_accent_bill"
        android:text="" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:background="@drawable/widget_live_dot_bill"
                android:text="" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/widget_bill_overview"
                android:textSize="10sp"
                android:textColor="#666666"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="5dp"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/widget_bill_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#888888"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Data -->
        <LinearLayout
            android:id="@+id/widget_content_with_data"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:visibility="gone">

            <!-- Expense -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_monthly_expense"
                    android:textSize="9sp"
                    android:textColor="#888888"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/widget_expense_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¥0"
                    android:textSize="20sp"
                    android:textColor="#1A1A1A"
                    android:fontFamily="monospace"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <!-- Income -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_monthly_income"
                    android:textSize="9sp"
                    android:textColor="#888888"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/widget_income_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¥0"
                    android:textSize="20sp"
                    android:textColor="#1A1A1A"
                    android:fontFamily="monospace"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <!-- Days -->
            <TextView
                android:id="@+id/widget_days_in_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="8sp"
                android:textColor="#AAAAAA"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp"
                android:layout_gravity="center_horizontal" />
        </LinearLayout>

        <!-- Empty -->
        <LinearLayout
            android:id="@+id/widget_empty_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_bill_empty"
                android:textSize="10sp"
                android:textColor="#AAAAAA"
                android:fontFamily="monospace" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>