<?xml version="1.0" encoding="utf-8"?>
<!--
  账单 3×2：主体是**近 7 天支出柱状图**（图形当主角），上面一行是「支出（主）+ 收入/预算剩余（次）」，
  底下一条主题色胶囊给预算用量或本月结余。柱子的高度由 Provider 用 clip 的 level 控制。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/widget_pad"
    android:background="@drawable/widget_card_round">

    <!-- Header: 实底徽章 + 标题 + 新增 pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="@dimen/widget_icon_badge"
            android:layout_height="@dimen/widget_icon_badge">

            <ImageView
                android:id="@+id/widget_bill_badge"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_shape_circle"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="¥"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF"
                android:gravity="center" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_bill_title"
            android:textSize="@dimen/widget_text_title"
            android:textColor="@color/widget_v2_text_primary"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/widget_add_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_add"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/widget_v2_accent"
            android:background="@drawable/widget_pill_soft"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <!-- Content -->
    <LinearLayout
        android:id="@+id/widget_content_with_data"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:visibility="gone">

        <!-- 支出（主）+ 收入 / 预算剩余（次） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_expense_label"
                    android:textSize="@dimen/widget_text_micro"
                    android:textColor="@color/widget_v2_text_secondary" />

                <TextView
                    android:id="@+id/widget_expense_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="@dimen/widget_text_value"
                    android:textColor="@color/widget_v2_text_primary"
                    android:textStyle="bold"
                    android:layout_marginTop="1dp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/widget_gap">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_income_label"
                        android:textSize="@dimen/widget_text_micro"
                        android:textColor="@color/widget_v2_text_secondary" />

                    <TextView
                        android:id="@+id/widget_income_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="@dimen/widget_text_micro"
                        android:textColor="@color/widget_v2_text_primary"
                        android:textStyle="bold"
                        android:layout_marginStart="6dp"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- 近 7 天支出柱状图：柱子高度由 clip 的 level 定，颜色运行时着主题色 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:layout_marginTop="2dp">

            <ImageView
                android:id="@+id/widget_bill_bar_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/widget_bar_clip"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_bill_bar_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:src="@drawable/widget_bar_clip"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_bill_bar_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:src="@drawable/widget_bar_clip"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_bill_bar_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:src="@drawable/widget_bar_clip"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_bill_bar_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:src="@drawable/widget_bar_clip"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_bill_bar_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:src="@drawable/widget_bar_clip"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_bill_bar_6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:src="@drawable/widget_bar_clip"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- 图下说明：左「近 7 天」，右「预算剩余 / 净收入」 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/widget_bill_week_label"
                android:textSize="@dimen/widget_text_micro"
                android:textColor="@color/widget_v2_text_tertiary" />

            <TextView
                android:id="@+id/widget_budget_card_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_budget_remaining"
                android:textSize="@dimen/widget_text_micro"
                android:textColor="@color/widget_v2_text_secondary" />

            <TextView
                android:id="@+id/widget_budget_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="@dimen/widget_text_micro"
                android:textColor="@color/widget_v2_text_primary"
                android:textStyle="bold"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Empty -->
    <LinearLayout
        android:id="@+id/widget_empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_bill_empty"
            android:textSize="12sp"
            android:textColor="@color/widget_v2_text_tertiary" />
    </LinearLayout>

</LinearLayout>
