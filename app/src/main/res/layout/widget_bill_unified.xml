<?xml version="1.0" encoding="utf-8"?>
<!--
  账单 3×2（定稿）：左栏「本月支出」大数字 + 预算用量条，右栏近 7 天支出柱状图（图形当主角）。
  柱高与用量条都靠 clip 的 level 定（RemoteViews 改不了控件尺寸）：用量条是「轨道 + clip 填充」
  叠在 FrameLayout 里，颜色运行时 setColorFilter，所以两层的默认白色都不是最终色。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_card_round">

    <!-- Header：色族徽章 + 标题 + 新增色片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="@dimen/widget_icon_badge"
            android:layout_height="@dimen/widget_icon_badge">

            <ImageView
                android:id="@+id/widget_bill_badge"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_shape_circle"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="¥"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF"
                android:gravity="center" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_bill_title"
            android:textSize="@dimen/widget_text_title"
            android:textColor="@color/widget_v2_text_primary"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/widget_add_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_add"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/widget_pill_tint1"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <!-- Content：左栏大数字 / 右栏柱状图 -->
    <LinearLayout
        android:id="@+id/widget_content_with_data"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:layout_marginTop="9dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="96dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_expense_label"
                android:textSize="@dimen/widget_text_micro"
                android:textColor="@color/widget_v2_text_secondary" />

            <TextView
                android:id="@+id/widget_expense_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="26sp"
                android:textColor="@color/widget_v2_text_primary"
                android:textStyle="bold"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- 预算用量条：轨道 + clip 填充（宽度由 level 定） -->
            <FrameLayout
                android:id="@+id/widget_bill_budget_bar"
                android:layout_width="match_parent"
                android:layout_height="9dp"
                android:layout_marginTop="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_bar_track"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/widget_bill_budget_fill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_bar_fill"
                    android:contentDescription="@null" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/widget_budget_card_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_budget_used"
                    android:textSize="@dimen/widget_text_micro"
                    android:textColor="@color/widget_v2_text_secondary" />

                <TextView
                    android:id="@+id/widget_budget_amount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0"
                    android:textSize="@dimen/widget_text_micro"
                    android:textColor="@color/widget_v2_text_primary"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- 近 7 天支出柱状图：柱高由 clip 的 level 定，颜色运行时着色（最高的一天换个色） -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:orientation="horizontal"
                android:gravity="bottom">

                <ImageView
                    android:id="@+id/widget_bill_bar_0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:src="@drawable/widget_bar_clip"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/widget_bill_bar_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/widget_bar_clip"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/widget_bill_bar_2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/widget_bar_clip"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/widget_bill_bar_3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/widget_bar_clip"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/widget_bill_bar_4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/widget_bar_clip"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/widget_bill_bar_5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/widget_bar_clip"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/widget_bill_bar_6"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/widget_bar_clip"
                    android:contentDescription="@null" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_bill_week_label"
                android:textSize="@dimen/widget_text_micro"
                android:textColor="@color/widget_v2_text_tertiary"
                android:gravity="center"
                android:layout_marginTop="3dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Empty -->
    <LinearLayout
        android:id="@+id/widget_empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_bill_empty"
            android:textSize="12sp"
            android:textColor="@color/widget_v2_text_tertiary" />
    </LinearLayout>

</LinearLayout>
