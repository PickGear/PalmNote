<?xml version="1.0" encoding="utf-8"?>
<!--
  本月记账 4×2（v22 WIDE，数据版）：hd(徽章+标题+「新增」胶囊) / 左「本月支出 hero + 预算条」右「近 7 天柱」。
  v22 口径：收入/结余/最高分类让位给柱状图（三列读数在 4×1 档）；预算没设时整块收起，不拿 0% 假装有预算。
  近 7 天柱走 addView(widget_v22_bars7)：柱高 = 当天 ÷ 峰值，今天（末柱）恒全不透明，其余 32%。
  柱高与用量条都靠 clip 的 level 定（RemoteViews 改不了控件尺寸）。
  空态沿用 v4：「本月还没有记账」整卡一句话，不留白板。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 壁纸层：app 内「自定义背景」开启时由 WidgetWallpaper 填充，卡片底色转透明 -->
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/widget_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="15dp"
        android:paddingVertical="13dp"
        android:background="@drawable/widget_card_round">

        <!-- Header：色族徽章 + 标题 + 新增色片（id 沿用 v4，bindHeader/bindAddButton 直接可用） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="@dimen/widget_v22_badge"
                android:layout_height="@dimen/widget_v22_badge">

                <ImageView
                    android:id="@+id/widget_bill_badge"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_shape_circle"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="¥"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFFFF"
                    android:gravity="center" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_bill_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="@string/widget_bill_title"
                android:textSize="@dimen/widget_v22_text_ttl"
                android:textStyle="bold"
                android:textColor="@color/widget_v22_text_1"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_add_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/widget_add"
                android:textSize="@dimen/widget_v22_text_lb"
                android:textStyle="bold"
                android:paddingHorizontal="9dp"
                android:paddingVertical="3dp"
                android:maxLines="1" />
        </LinearLayout>

        <!-- 有数据的内容区（bindDataVisibility 切换） -->
        <LinearLayout
            android:id="@+id/widget_content_with_data"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 左：本月支出 hero + 预算条 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_expense_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_expense_label"
                    android:textSize="@dimen/widget_v22_text_lb"
                    android:textColor="@color/widget_v22_text_2"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/widget_expense_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="0"
                    android:textSize="@dimen/widget_v22_text_hero"
                    android:textStyle="bold"
                    android:textColor="@color/widget_v22_text_1"
                    android:maxLines="1"
                    android:includeFontPadding="false" />

                <!-- 预算粗条：track 铺底 + fill 走 level（82% = setImageLevel 8200） -->
                <FrameLayout
                    android:id="@+id/widget_bill_budget_bar"
                    android:layout_width="match_parent"
                    android:layout_height="9dp"
                    android:layout_marginTop="8dp">

                    <ImageView
                        android:id="@+id/widget_bill_budget_track"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/widget_bar_track"
                        android:contentDescription="@null" />

                    <ImageView
                        android:id="@+id/widget_bill_budget_fill"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/widget_bar_fill"
                        android:contentDescription="@null" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/widget_budget_card_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/widget_v22_text_micro"
                        android:textColor="@color/widget_v22_text_2"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/widget_budget_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textSize="@dimen/widget_v22_text_micro"
                        android:textStyle="bold"
                        android:textColor="@color/widget_v22_text_1"
                        android:maxLines="1" />
                </LinearLayout>
            </LinearLayout>

            <!-- 右：近 7 天柱（addView widget_v22_bars7，bindBars7 上色与 level） -->
            <LinearLayout
                android:id="@+id/widget_bill_bars_host"
                android:layout_width="112dp"
                android:layout_height="78dp"
                android:layout_marginStart="10dp"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- 空态：本月一笔都没有时整卡一句话 -->
        <LinearLayout
            android:id="@+id/widget_empty_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_bill_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_bill_empty"
                android:textSize="@dimen/widget_v22_text_lb"
                android:textColor="@color/widget_v22_text_2"
                android:maxLines="2" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
