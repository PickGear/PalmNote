<?xml version="1.0" encoding="utf-8"?>
<!--
  总资产 2×1（定稿）：余额合计 + 一枚涨跌胶囊（本月净收入相对期初总资产的涨幅）。
  胶囊底是白底占位，运行时 setColorFilter 上「涨绿跌红」；数字点进记账页看明细。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="10dp"
    android:background="@drawable/widget_card_round">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/wallet_total_assets"
        android:textSize="@dimen/widget_text_micro"
        android:textColor="@color/widget_v2_text_secondary" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/widget_net_worth_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="22sp"
            android:textColor="@color/widget_v2_text_primary"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_net_worth_delta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="@dimen/widget_text_micro"
            android:textStyle="bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp" />
    </LinearLayout>

</LinearLayout>
