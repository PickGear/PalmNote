<?xml version="1.0" encoding="utf-8"?>
<!--
  习惯周历列头（v4）：近 7 天的「日」数字，与下方方柱逐列对齐（64dp 名列 + 18dp 柱 + 6dp 隙，
  今天列 24dp）。今天那格是列头顶：上圆角淡底（.tc/.tct）+ 色族色数字（.wkh.on），白字废止；
  行尾「本周」占位与 x/7 列对齐。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_habit_weekhead"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <!-- RemoteViews 白名单没有 Space/裸 View，占位用空 TextView -->
    <TextView
        android:layout_width="64dp"
        android:layout_height="1dp" />

    <TextView
        android:id="@+id/widget_habit_head_0"
        android:layout_width="18dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:gravity="center"
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="@color/widget_v2_text_tertiary"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_habit_head_1"
        android:layout_width="18dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:gravity="center"
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="@color/widget_v2_text_tertiary"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_habit_head_2"
        android:layout_width="18dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:gravity="center"
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="@color/widget_v2_text_tertiary"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_habit_head_3"
        android:layout_width="18dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:gravity="center"
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="@color/widget_v2_text_tertiary"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_habit_head_4"
        android:layout_width="18dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:gravity="center"
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="@color/widget_v2_text_tertiary"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_habit_head_5"
        android:layout_width="18dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:gravity="center"
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="@color/widget_v2_text_tertiary"
        android:maxLines="1" />

    <!-- 今天列的列头顶：上圆角淡底（.tct，运行时着色族淡色）+ 日期数字 -->
    <FrameLayout
        android:layout_width="24dp"
        android:layout_height="18dp"
        android:layout_marginStart="4dp">

        <ImageView
            android:id="@+id/widget_habit_head_6_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_col_top"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_habit_head_6"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="@color/widget_v2_text_tertiary"
            android:maxLines="1" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="right"
        android:text="@string/widget_this_week_label"
        android:textSize="10sp"
        android:textColor="@color/widget_v2_text_tertiary"
        android:maxLines="1" />
</LinearLayout>
