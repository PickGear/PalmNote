<?xml version="1.0" encoding="utf-8"?>
<!--
  v22 大点阵（稿 .dotg：4 列 × 2 行，点 13、隙 8）：8 个固定点，用于生活计数 2×2（6/8）。
  亮点族色 d、暗点 line 灰；夜间暗点 #3A4048（由 WidgetV22 按色调下发，勿写死在布局）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_v22_dotg_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="13dp"
        android:orientation="horizontal">

        <ImageView android:id="@+id/widget_v22_dotg_1" android:layout_width="13dp" android:layout_height="13dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_shape_circle" android:contentDescription="@null" />
        <ImageView android:id="@+id/widget_v22_dotg_2" android:layout_width="13dp" android:layout_height="13dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_shape_circle" android:contentDescription="@null" />
        <ImageView android:id="@+id/widget_v22_dotg_3" android:layout_width="13dp" android:layout_height="13dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_shape_circle" android:contentDescription="@null" />
        <ImageView android:id="@+id/widget_v22_dotg_4" android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/widget_shape_circle" android:contentDescription="@null" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="13dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <ImageView android:id="@+id/widget_v22_dotg_5" android:layout_width="13dp" android:layout_height="13dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_shape_circle" android:contentDescription="@null" />
        <ImageView android:id="@+id/widget_v22_dotg_6" android:layout_width="13dp" android:layout_height="13dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_shape_circle" android:contentDescription="@null" />
        <ImageView android:id="@+id/widget_v22_dotg_7" android:layout_width="13dp" android:layout_height="13dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_shape_circle" android:contentDescription="@null" />
        <ImageView android:id="@+id/widget_v22_dotg_8" android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/widget_shape_circle" android:contentDescription="@null" />
    </LinearLayout>
</LinearLayout>
