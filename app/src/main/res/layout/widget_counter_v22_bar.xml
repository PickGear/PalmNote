<?xml version="1.0" encoding="utf-8"?>
<!--
  计数器 4×1（v22 BAR，稿 §2-7 三列计数）：徽章 | 三列读数（主目标 当前/目标 / 副计数 ×2）。
  2026-10-25 对稿：去掉「生活计数器」标题与进度条 —— 稿里只有徽章 + 三列。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/widget_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="15dp"
        android:paddingVertical="9dp"
        android:background="@drawable/widget_card_round">

        <FrameLayout
            android:layout_width="@dimen/widget_v22_badge_sm"
            android:layout_height="@dimen/widget_v22_badge_sm">

            <ImageView
                android:id="@+id/widget_counter_badge"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_shape_circle"
                android:contentDescription="@null" />

            <ImageView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_gravity="center"
                android:src="@drawable/widget_ic_hash_white"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- 主目标列：标签 = 目标名，值 = 当前/目标 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/widget_counter_bar_main_lbl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/widget_v22_text_micro"
                android:textColor="@color/widget_v22_text_2"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_counter_bar_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/widget_v22_text_val"
                android:textStyle="bold"
                android:textColor="@color/widget_v22_text_1"
                android:maxLines="1"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- 副计数列 ×2 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/widget_counter_bar_sub1_lbl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/widget_v22_text_micro"
                android:textColor="@color/widget_v22_text_2"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_counter_bar_sub1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/widget_v22_text_val"
                android:textStyle="bold"
                android:textColor="@color/widget_v22_text_1"
                android:maxLines="1"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/widget_counter_bar_sub2_lbl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/widget_v22_text_micro"
                android:textColor="@color/widget_v22_text_2"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_counter_bar_sub2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/widget_v22_text_val"
                android:textStyle="bold"
                android:textColor="@color/widget_v22_text_1"
                android:maxLines="1"
                android:includeFontPadding="false" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
