<?xml version="1.0" encoding="utf-8"?>
<!--
  概览 4×3（定稿）：左侧**三层同心环**（预算 82% / 目标 64% / 待办完成度，苹果活动环做法），
  右侧四张两行色片（上行色点 + 标签，下行大数值）。环的半径由控件尺寸定（140/110/82dp），
  粗细 11dp 写在 drawable 里，进度用 setImageLevel、颜色用 setColorFilter（轨道用同色相低透明度）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/widget_pad"
    android:background="@drawable/widget_card_round">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="@dimen/widget_icon_badge"
            android:layout_height="@dimen/widget_icon_badge">

            <ImageView
                android:id="@+id/widget_dashboard_icon_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_shape_circle"
                android:contentDescription="@null" />

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center"
                android:src="@drawable/widget_ic_home_white"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_dashboard_title"
            android:textSize="@dimen/widget_text_title"
            android:textColor="@color/widget_v2_text_primary"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/widget_dashboard_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/widget_text_micro"
            android:textColor="@color/widget_v2_text_tertiary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="@dimen/widget_gap">

        <FrameLayout
            android:layout_width="140dp"
            android:layout_height="140dp">

            <FrameLayout
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="center">

                <ImageView
                    android:id="@+id/widget_dashboard_budget_ring_track"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_ring_track_11"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/widget_dashboard_budget_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_ring_arc_11"
                    android:contentDescription="@null" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center">

                <ImageView
                    android:id="@+id/widget_dashboard_goal_ring_track"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_ring_track_11"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/widget_dashboard_goal_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_ring_arc_11"
                    android:contentDescription="@null" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:layout_gravity="center">

                <ImageView
                    android:id="@+id/widget_dashboard_todo_ring_track"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_ring_track_11"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/widget_dashboard_todo_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_ring_arc_11"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_dashboard_ring_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/widget_v2_text_primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layout_marginStart="14dp">

            <FrameLayout
                android:id="@+id/widget_dashboard_budget_card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_dashboard_budget_tint"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_chip_round"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/widget_dashboard_budget_dot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:src="@drawable/widget_shape_circle"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/widget_dashboard_budget_sub"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="@dimen/widget_text_micro"
                            android:textColor="@color/widget_v2_text_secondary"
                            android:layout_marginStart="6dp"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/widget_dashboard_budget"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_dashboard_goal_card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="7dp">

                <ImageView
                    android:id="@+id/widget_dashboard_goal_tint"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_chip_round"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/widget_dashboard_goal_dot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:src="@drawable/widget_shape_circle"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/widget_dashboard_goal_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="@dimen/widget_text_micro"
                            android:textColor="@color/widget_v2_text_secondary"
                            android:layout_marginStart="6dp"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/widget_dashboard_goal_pct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_dashboard_todo_card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="7dp">

                <ImageView
                    android:id="@+id/widget_dashboard_todo_tint"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_chip_round"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/widget_dashboard_todo_dot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:src="@drawable/widget_shape_circle"
                            android:contentDescription="@null" />

                        <TextView
                            android:text="@string/widget_todos_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="@dimen/widget_text_micro"
                            android:textColor="@color/widget_v2_text_secondary"
                            android:layout_marginStart="6dp"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/widget_dashboard_todo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_dashboard_anniversary_card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="7dp">

                <ImageView
                    android:id="@+id/widget_dashboard_anniversary_tint"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_chip_round"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/widget_dashboard_anniversary_dot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:src="@drawable/widget_shape_circle"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/widget_dashboard_days_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="@dimen/widget_text_micro"
                            android:textColor="@color/widget_v2_text_secondary"
                            android:layout_marginStart="6dp"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/widget_dashboard_days"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
