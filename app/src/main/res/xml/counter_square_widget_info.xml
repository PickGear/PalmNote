<?xml version="1.0" encoding="utf-8"?>
<!-- counter_square_widget_info：targetCell 2×2（v22 四档之一），预览图与 previewLayout 同源真实布局 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="74dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:maxResizeWidth="400dp"
    android:maxResizeHeight="250dp"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_counter_v22_square"
    android:widgetCategory="home_screen"
    android:description="@string/widget_counter_desc"
    android:previewImage="@drawable/widget_preview_counter_square_card"
    android:resizeMode="horizontal|vertical" />
