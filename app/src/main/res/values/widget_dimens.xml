<?xml version="1.0" encoding="utf-8"?>
<!--
  小组件设计令牌：字阶与间距。组件布局一律引用这里，不再随手写 textSize/padding。

  字阶只有四档，一个组件里同一档只出现一次语义：
    label   标签   —— 设计稿 `.lbl` 9px：说明「这是哪一项」，三级色（个别处着族色/警示色）
    micro   微标签 —— 设计稿 `.micro` 10px：补充口径/状态，次级色
    value  数值   —— 组件的主角，加粗、明显大于其他文字
    detail 说明   —— 补充信息，三级色
  标题（组件名）单独一档，跟数值拉开。

  间距三档：pad 卡片内边距 / gap 块与块之间 / inner_pad 子卡内边距。
  倒计时卡稿子用 14px 内边距（其余大卡 16px），单独一档 pad_compact。
-->
<resources>
    <!-- 标题与徽章按设计稿量值给（design-v4.html 的 `.ttl` 11px / `.bdg` 16px）：
         头部是紧凑的辅助标签，不是大标题，做大了整张卡的头就压住了内容区。 -->
    <dimen name="widget_text_title">11sp</dimen>
    <dimen name="widget_text_label">9sp</dimen>
    <dimen name="widget_text_micro">10sp</dimen>

    <dimen name="widget_pad">16dp</dimen>
    <dimen name="widget_pad_compact">14dp</dimen>
    <dimen name="widget_gap">8dp</dimen>
    <dimen name="widget_icon_badge">16dp</dimen>
</resources>
