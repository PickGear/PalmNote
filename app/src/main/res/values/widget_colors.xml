    <!-- ═══════════════════════════════════════════════════════════════
         V2 圆角卡片设计语言令牌（values-night 中有对应深色覆盖，
         小组件布局在桌面进程内以桌面 uiMode 解析，跟随系统深色模式）
         ═══════════════════════════════════════════════════════════════ -->
    <color name="widget_v2_card_bg">#FFFFFFFF</color>
    <color name="widget_v2_soft_mint">#FFEEF5F3</color>
    <color name="widget_v2_soft_gray">#FFF5F7F7</color>
    <!-- 行底 / 芯片底 / 天数胶囊底：以前把色值直接写死在 drawable 里，系统深色模式下这三块仍是浅色板，
         而板上的字已经变浅 —— 现在是令牌，随系统明暗解析，也被 WidgetToneSweep 认作「跟着色调换」的面板底。 -->
    <color name="widget_v2_item_bg">#FFF8F8F8</color>
    <color name="widget_v2_chip_bg">#FFF5F5F5</color>
    <color name="widget_v2_days_bg">#FFE8F4FD</color>
    <color name="widget_v2_text_primary">#FF15181A</color>
    <color name="widget_v2_text_secondary">#FF6B7B77</color>
    <color name="widget_v2_text_tertiary">#FF9AA8A4</color>
    <color name="widget_v2_accent">#FF0891B2</color>
    <!-- 轨道/空位灰：design-v4 的 track 变量（bar 轨道、未打卡格、分隔线同源） -->
    <color name="widget_v2_ring">#FFE9EDEC</color>
    <!-- 涨跌（总资产胶囊）：涨绿跌红 -->
    <color name="widget_delta_up">#FF16A34A</color>
    <color name="widget_delta_down">#FFDC2626</color>
    <color name="widget_delta_up_tint">#FFDCFCE7</color>
    <color name="widget_delta_down_tint">#FFFEE2E2</color>
    <!-- 语义警示（逾期红字等，design-v4 .warn 同源）：夜间在 values-night 提亮 -->
    <color name="widget_risk_red">#FFC62828</color>
    <!-- 警示胶囊底：红 12%（design-v4 .warn 背景），夜间换红 20% -->
    <color name="widget_warn_bg">#1FDC2626</color>


    <!-- ═══════════════════════════════════════════════════════════════
         色族：一族 = 淡底（widget_tint_N，做圆角砖/胶囊底）+ 饱和前景（widget_hue_N，做图标/色点/数字）。
         参考主页那两张卡片就是这套用法：图标砖淡底 + 饱和图标、色片清单淡底 + 同色圆点。
         组件里不要只用主题色 —— 按条目取不同色族。
         ═══════════════════════════════════════════════════════════════ -->
    <color name="widget_tint_1">#FFFDEBE3</color>
    <color name="widget_hue_1">#FFF97316</color>
    <color name="widget_tint_2">#FFE3F0FA</color>
    <color name="widget_hue_2">#FF3B82F6</color>
    <color name="widget_tint_3">#FFE4F5E9</color>
    <color name="widget_hue_3">#FF22C55E</color>
    <color name="widget_tint_4">#FFFBE7F0</color>
    <color name="widget_hue_4">#FFEC4899</color>
    <color name="widget_tint_5">#FFEDE9FE</color>
    <color name="widget_hue_5">#FF8B5CF6</color>
    <color name="widget_tint_6">#FFFEF3C7</color>
    <color name="widget_hue_6">#FFEAB308</color>

    <!-- ═══════════════════════════════════════════════════════════════
         v22 色板（docs/mockups/widgets/v22/index.html 的 CSS 提取）：
         一族三档 —— d 主色（图形/色点/填充）、dt 淡底（胶囊底）、di 深墨（数值）。
         夜间只覆盖 dt/di（dt 换深底、di 提亮），d 不变（图形仍饱和），见 values-night。
         上方 widget_tint_N/widget_hue_N 为 v4 遗留，逐族迁到 v22 后删。
         ═══════════════════════════════════════════════════════════════ -->
    <color name="widget_v22_c1">#FF4A72F5</color>
    <color name="widget_v22_c1_tint">#FFEDF1FE</color>
    <color name="widget_v22_c1_ink">#FF2F5DF4</color>
