        <activity-alias
            android:name=".IconGreenWhite"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_gw"
            android:roundIcon="@mipmap/ic_launcher_gw_round"
            android:targetActivity="com.palmnote.MainActivity"
            android:theme="@style/Theme.PalmNote.Splash.GreenWhite">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 黑白 -->
