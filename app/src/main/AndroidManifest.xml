<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 显式移除网络权限，确保纯离线 -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name="com.palmnote.PalmNoteApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PalmNote"
        tools:targetApi="34">
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <activity
            android:name="com.palmnote.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.PalmNote">
        </activity>

        <!-- 绿白 -->
        <activity-alias
            android:name=".IconGreenWhite"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_gw"
            android:roundIcon="@mipmap/ic_launcher_gw_round"
            android:targetActivity="com.palmnote.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 黑白 -->
        <activity-alias
            android:name=".IconBlackWhite"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_bw"
            android:roundIcon="@mipmap/ic_launcher_bw_round"
            android:targetActivity="com.palmnote.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 白黑 -->
        <activity-alias
            android:name=".IconWhiteBlack"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_wb"
            android:roundIcon="@mipmap/ic_launcher_wb_round"
            android:targetActivity="com.palmnote.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 青白（默认） -->
        <activity-alias
            android:name=".IconCyanWhite"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_cyan"
            android:roundIcon="@mipmap/ic_launcher_cyan_round"
            android:targetActivity="com.palmnote.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <receiver
            android:name="com.palmnote.ui.widget.BillWidgetProvider"
            android:exported="true"
            android:label="@string/widget_bill_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bill_widget_medium_info" />
        </receiver>
        <!-- 组件配置页：桌面摆放/长按改设置时拉起。
             除账单外都只调透明度，账单多一段选账本，所以两个 Activity -->
        <activity
            android:name="com.palmnote.ui.widget.WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.PalmNote">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.palmnote.ui.widget.BillWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.PalmNote">
            <intent-filter>
